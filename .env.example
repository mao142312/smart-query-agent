SAD_ENVIRONMENT=development
SAD_LOG_LEVEL=INFO
SAD_QUERY_BACKEND=sqlite
SAD_KNOWLEDGE_BACKEND=mock
SAD_KNOWLEDGE_FILE=data/mock_knowledge.json
SAD_MAX_RETRIES=2
SAD_CONFIDENCE_THRESHOLD=0.65

# DeepSeek：复制本文件为 .env 后填写，切勿提交真实密钥
SAD_LLM_BACKEND=auto
SAD_LLM_MODEL=deepseek-v4-flash
SAD_LLM_API_MODE=chat_completions
SAD_LLM_BASE_URL=https://api.deepseek.com
SAD_LLM_THINKING=enabled
SAD_LLM_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=

# 使用 Trino 时填写
SAD_TRINO_HOST=localhost
SAD_TRINO_PORT=8080
SAD_TRINO_USER=smart-ask-data
SAD_TRINO_CATALOG=hive
SAD_TRINO_SCHEMA=default
SAD_TRINO_HTTP_SCHEME=http
