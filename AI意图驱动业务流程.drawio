  <diagram name="AI意图驱动业务流程" id="ai-intent-business-flow">
    <mxGraphModel dx="1600" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2200" background="#F5F5DC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="用户提出业务问题&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;例：查询齐鑫涛最近一个月业绩&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="3" value="Business Intent Recognizer（AI）&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;提取业务对象、指标描述、动作、时间、维度、筛选、分组与歧义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3366CC;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="4" value="是否具备可检索条件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#333333;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="310" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="5" value="请求用户澄清&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;补充条件或消除歧义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FF9966;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="325" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="6" value="Structured Retrieval Query&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;生成结构化检索条件：指标线索 / 实体 / 动作 / 时间 / 维度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6FA;strokeColor=#333333;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="520" height="85" as="geometry"/></mxCell>
        <mxCell id="7" value="Knowledge Retrieval&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;按结构化意图召回 Top N 指标、维度、业务口径和数据源定义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#3366CC;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="605" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="8" value="公司知识库&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;指标 / 维度 / 口径 / 表字段 / 权限&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="9" value="Top N 候选知识可靠？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#333333;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="745" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="10" value="检索修复&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;扩展召回 / 调整查询 / 请求澄清&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FF9966;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="11" value="Grounded Logical Plan Generator（AI）&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;融合原问题 + 结构化意图 + Top N 知识，生成指标、时间、过滤、分组和计算计划&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD966;strokeColor=#3366CC;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="910" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="12" value="逻辑计划完整且符合知识口径？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#333333;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="1060" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="13" value="计划修复&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;重新消歧 / 检索知识 / 调整计划&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FF9966;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="1080" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="14" value="SQL Generator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;根据已校验逻辑计划生成只读 SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="1230" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="15" value="SQL Validator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;只读 / 白名单表 / 强制过滤 / 时间范围 / LIMIT / 指标表达式&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="1360" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="16" value="SQL 校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#333333;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="1500" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="17" value="SQL 修复 / 重试&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;记录反馈，未超限则重新生成&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FF9966;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="1512" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="18" value="Execute Engine&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;执行 SQL 并返回结果集&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B6D7A8;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="1650" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="19" value="SQLite / Trino&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;业务数据源&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1640" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="20" value="Result Validator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;执行成功 / 非空 / 值完整 / 业务范围 / 维度完整 / 时间有效&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1785" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="21" value="结果可靠？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEB99;strokeColor=#333333;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="1925" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="22" value="结果修复 / 重试&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;根据错误反馈重新规划或生成 SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#FF9966;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="1935" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="23" value="Answer Generator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;基于查询结果、业务口径与错误状态生成回答&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9E6;strokeColor=#333333;strokeWidth=1.5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="2070" width="500" height="85" as="geometry"/></mxCell>
        <mxCell id="24" value="综合可信度评分&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;知识 × 时间 × 计划 × SQL × 结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6FA;strokeColor=#333333;strokeWidth=1.5;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="2200" width="460" height="80" as="geometry"/></mxCell>
